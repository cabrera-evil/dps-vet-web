# API URL
NEXT_PUBLIC_API_URL=http://localhost:3000

# Proxy settings (optional)
NEXT_PUBLIC_PROXY=false

# Host settings (optional)
NEXT_PUBLIC_HOST=localhost

# Google AdSense
NEXT_PUBLIC_GOOGLE_ADSENSE_ID=your-adsense-id

# Google Analytics
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=your-analytics-id

# Google Sites Verification
NEXT_PUBLIC_GOOGLE_SITES_VERIFICATION=your-sites-verification-code

# Auth Configuration
AUTH_SECRET=your-auth-secret
AUTH_DEBUG=true

# Firebase Admin (server-only, do NOT prefix with NEXT_PUBLIC_)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-key\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=your-firebase-project-id.appspot.com
FIREBASE_DATABASE_URL=https://your-firebase-project-id-default-rtdb.firebaseio.com

# Firebase Web API key (server-only; used to verify email/password sign-in via
# the Identity Toolkit REST API — this is the project's public Web API key,
# not a secret, but is still kept out of NEXT_PUBLIC_ so it is only ever used server-side)
FIREBASE_WEB_API_KEY=your-firebase-web-api-key

# Initial admin account (optional; only used by `pnpm db:seed`)
ADMIN_EMAIL=admin@sanroque.com
ADMIN_PASSWORD=your-admin-password
ADMIN_NAME=Admin
ADMIN_PHONE=+10000000000

# Sentry Configuration
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn
SENTRY_PROJECT=your-sentry-project
SENTRY_ORG=your-sentry-org
